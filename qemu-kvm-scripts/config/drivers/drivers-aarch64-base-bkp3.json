{
    "NETWORK": "-net none",
    "USB_EHCI": "-device usb-ehci,id=usb1",
    "USB_REDIR": "-device nec-usb-xhci,id=usb -chardev spicevmc,name=usbredir,id=usbredirchardev1 -device usb-redir,chardev=usbredirchardev1,id=usbredirdev1 -chardev spicevmc,name=usbredir,id=usbredirchardev2 -device usb-redir,chardev=usbredirchardev2,id=usbredirdev2 -chardev spicevmc,name=usbredir,id=usbredirchardev3 -device usb-redir,chardev=usbredirchardev3,id=usbredirdev3",
    "_NVIDIA_GPU_ID": "0000:02:00.0",
    "_NVIDIA_GPU": "-device vfio-pci,host=${NVIDIA_GPU_ID},multifunction=on",
    "XILINX_FPGA_ID": "0000:85:00.0",
    "XILINX_FPGA": "-device vfio-pci,host=${XILINX_FPGA_ID}",
    "VGA": "-device virtio-gpu",
    "_VGA": "-vga qxl",
    "SCREEN": "-display none",
    "_SCREEN": "-display sdl,gl=on",
    "_SOUND": "-device virtio-sound-pci,audiodev=pa1 -audiodev pa,id=pa1,out.mixing-engine=off",
    "SOUND": "-device ich9-intel-hda -device hda-duplex,audiodev=pa1 -audiodev pa,id=pa1,out.mixing-engine=off",
    "SERIAL_PASSTHROUGH": "-chardev serial,path=/dev/ttyS0,id=myserial -device pci-serial,chardev=myserial",
    "SPICE": "-device virtio-serial-pci -spice port=${SPICE_PORT},addr=${SPICE_IP_ADDR},disable-ticketing=on,seamless-migration=on -chardev spicevmc,id=vdagent,name=vdagent -device virtserialport,chardev=vdagent,name=com.redhat.spice.0 -usb -device usb-tablet",
    "QGA_SOCKET": "/tmp/qemu-ga.sock",
    "QGA": "-device virtio-serial -chardev socket,path=${QGA_SOCKET},server=on,wait=off,id=qga0 -device virtserialport,chardev=qga0,name=org.qemu.guest_agent.0",
    "MISC": "-device virtio-serial -chardev socket,path=/tmp/mmc.socket,server=on,wait=off,id=char0 -device virtserialport,chardev=char0,name=mmc0 -device usb-kbd -kernel ../disk-images/kernel/debian-12-10-mirai-rpi5-image-2 -initrd ../disk-images/initrd/debian-12-10-mirai-rpi5-initrd-2.img -serial stdio",
    "KERNEL_ARG": "root=/dev/vda2 rw console=ttyAMA0"
}
